<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.callcenter.ui.controller.CallCentersController" styleClass="root-pane">
    <top>
        <VBox spacing="12" styleClass="header-box">
            <padding><Insets top="16" right="16" bottom="12" left="16"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Колл-центры" styleClass="title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="infoLabel" styleClass="info-label"/>
            </HBox>
            <FlowPane hgap="10" vgap="8" styleClass="filter-bar">
                <TextField fx:id="searchField" promptText="Поиск: название, адрес" prefWidth="300"/>
            </FlowPane>
        </VBox>
    </top>
    <center>
        <TableView fx:id="table">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <placeholder><Label text="Колл-центров не найдено"/></placeholder>
            <columns>
                <TableColumn fx:id="nameColumn" text="Название" prefWidth="200"/>
                <TableColumn fx:id="addressColumn" text="Адрес" prefWidth="280"/>
                <TableColumn fx:id="activeColumn" text="Статус" prefWidth="110"/>
                <TableColumn fx:id="operatorsColumn" text="Операторов" prefWidth="100"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT" styleClass="button-bar">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Button text="Добавить" onAction="#onAdd" styleClass="primary-button"/>
            <Button fx:id="editButton" text="Изменить" onAction="#onEdit" styleClass="primary-button"/>
            <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete" styleClass="danger-button"/>
            <Button text="Обновить" onAction="#onRefresh" styleClass="secondary-button"/>
        </FlowPane>
    </bottom>
</BorderPane>

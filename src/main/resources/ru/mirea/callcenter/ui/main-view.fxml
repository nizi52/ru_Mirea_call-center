<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>

<!-- Главное окно: четыре вкладки, по одной на каждую сущность. -->
<TabPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="ru.mirea.callcenter.ui.controller.ShellController"
         fx:id="tabs" tabClosingPolicy="UNAVAILABLE" styleClass="main-tabs">
    <Tab text="Обращения">
        <content><fx:include fx:id="appeals" source="appeals-view.fxml"/></content>
    </Tab>
    <Tab text="Клиенты">
        <content><fx:include fx:id="clients" source="clients-view.fxml"/></content>
    </Tab>
    <Tab text="Операторы">
        <content><fx:include fx:id="operators" source="operators-view.fxml"/></content>
    </Tab>
    <Tab text="Колл-центры">
        <content><fx:include fx:id="callCenters" source="call-centers-view.fxml"/></content>
    </Tab>
</TabPane>

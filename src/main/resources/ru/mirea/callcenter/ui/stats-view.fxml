<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.callcenter.ui.controller.StatsController"
      spacing="14" prefWidth="820" prefHeight="520" styleClass="root-pane">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="Статистика обращений" styleClass="title"/>
    <Label text="Учитываются обращения, показанные в главной таблице (с учётом поиска и фильтров)." styleClass="hint-label"/>

    <HBox spacing="12">
        <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS"><Label fx:id="totalValue" styleClass="stat-value"/><Label text="Всего обращений" styleClass="stat-caption"/></VBox>
        <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS"><Label fx:id="openValue" styleClass="stat-value"/><Label text="Не закрыто" styleClass="stat-caption"/></VBox>
        <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS"><Label fx:id="avgValue" styleClass="stat-value"/><Label text="Среднее время до закрытия" styleClass="stat-caption"/></VBox>
        <VBox styleClass="stat-tile" HBox.hgrow="ALWAYS"><Label fx:id="escalatedValue" styleClass="stat-value"/><Label text="Доля эскалированных" styleClass="stat-caption"/></VBox>
    </HBox>

    <HBox spacing="12" VBox.vgrow="ALWAYS">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="По статусам" styleClass="section-title"/>
            <TableView fx:id="statusTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="statusNameColumn" text="Статус"/>
                    <TableColumn fx:id="statusCountColumn" text="Кол-во" maxWidth="80"/>
                </columns>
            </TableView>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="По категориям" styleClass="section-title"/>
            <TableView fx:id="categoryTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="categoryNameColumn" text="Категория"/>
                    <TableColumn fx:id="categoryCountColumn" text="Кол-во" maxWidth="80"/>
                </columns>
            </TableView>
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Нагрузка по операторам" styleClass="section-title"/>
            <TableView fx:id="operatorTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                <columns>
                    <TableColumn fx:id="operatorNameColumn" text="Оператор"/>
                    <TableColumn fx:id="operatorCountColumn" text="Кол-во" maxWidth="80"/>
                </columns>
            </TableView>
        </VBox>
    </HBox>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Закрыть" onAction="#onClose" defaultButton="true" styleClass="primary-button"/>
    </HBox>
</VBox>

<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.callcenter.ui.controller.OperatorFormController"
      spacing="14" prefWidth="460" styleClass="root-pane">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label fx:id="titleLabel" styleClass="title"/>
    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="ФИО *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="fullNameField" promptText="Иванова Анна" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Логин *" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="loginField" promptText="aivanova" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Колл-центр *" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ComboBox fx:id="callCenterBox" maxWidth="Infinity" promptText="Выберите колл-центр" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Статус" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <CheckBox fx:id="activeCheck" text="Активен (можно назначать обращения)" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>
    <Label fx:id="errorLabel" wrapText="true" styleClass="error-label"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="saveButton" text="Сохранить" onAction="#onSave" defaultButton="true" styleClass="primary-button"/>
        <Button text="Отмена" onAction="#onCancel" cancelButton="true" styleClass="secondary-button"/>
    </HBox>
</VBox>

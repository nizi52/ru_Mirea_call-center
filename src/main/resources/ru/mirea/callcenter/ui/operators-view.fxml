<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.callcenter.ui.controller.OperatorsController" styleClass="root-pane">
    <top>
        <VBox spacing="12" styleClass="header-box">
            <padding><Insets top="16" right="16" bottom="12" left="16"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="Операторы" styleClass="title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="infoLabel" styleClass="info-label"/>
            </HBox>
            <FlowPane hgap="10" vgap="8" styleClass="filter-bar">
                <TextField fx:id="searchField" promptText="Поиск: ФИО, логин, колл-центр" prefWidth="300"/>
                <ComboBox fx:id="callCenterFilter" promptText="Колл-центр" prefWidth="190"/>
                <CheckBox fx:id="activeOnlyCheck" text="Только активные"/>
                <Button text="Сбросить" onAction="#onResetFilters" styleClass="secondary-button"/>
            </FlowPane>
        </VBox>
    </top>
    <center>
        <TableView fx:id="table">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
            <placeholder><Label text="Операторов не найдено"/></placeholder>
            <columns>
                <TableColumn fx:id="nameColumn" text="ФИО" prefWidth="200"/>
                <TableColumn fx:id="loginColumn" text="Логин" prefWidth="130"/>
                <TableColumn fx:id="callCenterColumn" text="Колл-центр" prefWidth="170"/>
                <TableColumn fx:id="activeColumn" text="Статус" prefWidth="100"/>
                <TableColumn fx:id="loadColumn" text="Активных обращений" prefWidth="140"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT" styleClass="button-bar">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Button text="Добавить" onAction="#onAdd" styleClass="primary-button"/>
            <Button fx:id="editButton" text="Изменить" onAction="#onEdit" styleClass="primary-button"/>
            <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete" styleClass="danger-button"/>
            <Button text="Обновить" onAction="#onRefresh" styleClass="secondary-button"/>
        </FlowPane>
    </bottom>
</BorderPane>

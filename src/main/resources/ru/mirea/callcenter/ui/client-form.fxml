<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.callcenter.ui.controller.ClientFormController"
      spacing="14" prefWidth="420" styleClass="root-pane">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label fx:id="titleLabel" styleClass="title"/>
    <GridPane hgap="12" vgap="12">
        <columnConstraints>
            <ColumnConstraints minWidth="90"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
        <Label text="ФИО *" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" promptText="Иванов Иван Иванович" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Телефон *" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="phoneField" promptText="+7 900 123-45-67" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="E-mail" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" promptText="необязательно" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>
    <Label fx:id="errorLabel" wrapText="true" styleClass="error-label"/>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Сохранить" onAction="#onSave" defaultButton="true" styleClass="primary-button"/>
        <Button text="Отмена" onAction="#onCancel" cancelButton="true" styleClass="secondary-button"/>
    </HBox>
</VBox>

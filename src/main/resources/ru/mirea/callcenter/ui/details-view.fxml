<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.callcenter.ui.controller.DetailsController"
      spacing="12" prefWidth="520" styleClass="root-pane">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label text="Сведения об обращении" styleClass="title"/>

    <Label text="Обращение" styleClass="section-title"/>
    <GridPane hgap="12" vgap="6">
        <columnConstraints><ColumnConstraints minWidth="110"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
        <Label text="Тема" styleClass="form-label" GridPane.rowIndex="0"/>
        <Label fx:id="topicValue" wrapText="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Категория" styleClass="form-label" GridPane.rowIndex="1"/>
        <Label fx:id="categoryValue" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Статус" styleClass="form-label" GridPane.rowIndex="2"/>
        <Label fx:id="statusValue" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Создано" styleClass="form-label" GridPane.rowIndex="3"/>
        <Label fx:id="createdValue" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label text="Закрыто" styleClass="form-label" GridPane.rowIndex="4"/>
        <Label fx:id="closedValue" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
    </GridPane>

    <Label text="Клиент" styleClass="section-title"/>
    <GridPane hgap="12" vgap="6">
        <columnConstraints><ColumnConstraints minWidth="110"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
        <Label text="ФИО" styleClass="form-label" GridPane.rowIndex="0"/>
        <Label fx:id="clientNameValue" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Телефон" styleClass="form-label" GridPane.rowIndex="1"/>
        <Label fx:id="clientPhoneValue" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Email" styleClass="form-label" GridPane.rowIndex="2"/>
        <Label fx:id="clientEmailValue" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Label text="Оператор" styleClass="section-title"/>
    <GridPane hgap="12" vgap="6">
        <columnConstraints><ColumnConstraints minWidth="110"/><ColumnConstraints hgrow="ALWAYS"/></columnConstraints>
        <Label text="ФИО" styleClass="form-label" GridPane.rowIndex="0"/>
        <Label fx:id="operatorNameValue" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Логин" styleClass="form-label" GridPane.rowIndex="1"/>
        <Label fx:id="operatorLoginValue" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Колл-центр" styleClass="form-label" GridPane.rowIndex="2"/>
        <Label fx:id="operatorCallCenterValue" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Состояние" styleClass="form-label" GridPane.rowIndex="3"/>
        <Label fx:id="operatorActiveValue" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Закрыть" onAction="#onClose" defaultButton="true" styleClass="primary-button"/>
    </HBox>
</VBox>
